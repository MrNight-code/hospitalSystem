<!--  -->@using HospitalData.Services
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HospitalWeb</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (SessionService.CurrentUser != null)
        {
            @* --- NUEVO BLOQUE DE CÓDIGO --- *@
            @* Aquí es donde se añaden los enlaces específicos para cada rol. *@
            @if (SessionService.CurrentUser.RoleName == "Administrativo")
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="gestion-doctores">
                        <span class="bi bi-person-rolodex" aria-hidden="true"></span> Doctores
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="gestion-pacientes">
                        <span class="bi bi-people-fill" aria-hidden="true"></span> Pacientes
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="gestion-inventario">
                        <span class="bi bi-capsule" aria-hidden="true"></span> Inventario
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="calendario-citas">
                        <span class="bi bi-calendar-week" aria-hidden="true"></span> Citas
                    </NavLink>
                </div>
            }
            @if (SessionService.CurrentUser.RoleName == "Doctor")
            {
                @* Portal Médico - Menú desplegable para Doctores *@
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link text-start w-100" @onclick="ToggleDoctorMenu">
                        <span class="bi bi-clipboard2-pulse-fill" aria-hidden="true"></span> Portal Médico
                        <span class="bi @(doctorMenuExpanded ? "bi-chevron-up" : "bi-chevron-down") float-end"></span>
                    </button>
                </div>

                @* Submenús del Portal Médico - Solo visible cuando está expandido *@
                @if (doctorMenuExpanded)
                {
                    <div class="nav-item px-3 ps-5">
                        <NavLink class="nav-link" href="doctor/mi-agenda">
                            <span class="bi bi-calendar-check" aria-hidden="true"></span> Mi Agenda
                        </NavLink>
                    </div>
                    <div class="nav-item px-3 ps-5">
                        <NavLink class="nav-link" href="doctor/buscar-paciente">
                            <span class="bi bi-search" aria-hidden="true"></span> Buscar Paciente
                        </NavLink>
                    </div>
                    <div class="nav-item px-3 ps-5">
                        <NavLink class="nav-link" href="doctor/historial-paciente">
                            <span class="bi bi-file-medical" aria-hidden="true"></span> Historial Clínico
                        </NavLink>
                    </div>
                    <div class="nav-item px-3 ps-5">
                        <NavLink class="nav-link" href="doctor/prescripciones-activas">
                            <span class="bi bi-clipboard2-heart" aria-hidden="true"></span> Prescripciones Activas
                        </NavLink>
                    </div>
                }
            }
            @* --- FIN DEL NUEVO BLOQUE --- *@


            @* Se muestra si el usuario HA iniciado sesión *@
            <div class="nav-item px-3">
                <span class="nav-link text-white">
                    <span class="bi bi-person-circle" aria-hidden="true"></span>
                    Bienvenido, <strong>@SessionService.CurrentUser.RoleName</strong>
                </span>
            </div>
            <div class="nav-item px-3">
                <button class="btn btn-link nav-link" @onclick="Logout">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
                </button>
            </div>
        }
        else
        {
            @* Se muestra si NADIE ha iniciado sesión *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    // Variable de estado para controlar la expansión del menú del Portal Médico
    private bool doctorMenuExpanded = false;

    protected override void OnInitialized()
    {
        SessionService.OnChange += StateHasChanged;
    }

    private void Logout()
    {
        SessionService.Logout();
        NavigationManager.NavigateTo("/login");
    }

    // Método para alternar la visibilidad del menú desplegable del Portal Médico
    private void ToggleDoctorMenu()
    {
        doctorMenuExpanded = !doctorMenuExpanded;
    }

    public void Dispose()
    {
        SessionService.OnChange -= StateHasChanged;
    }
}
