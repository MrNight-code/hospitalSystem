@page "/doctor/buscar-paciente"
@using HospitalData.Models
@using HospitalData.Services
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager
@inject IDoctorService DoctorService

<PageTitle>Buscar Paciente</PageTitle>

<Autorizacion RolRequerido="Doctor">

    <div class="container-fluid">
        <h1>🔍 Buscar Paciente</h1>
        <p>Encuentra información de pacientes por nombre, apellido o ID</p>

        <hr />

        @* SECCIÓN: FORMULARIO DE BÚSQUEDA *@
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-search"></i> Criterios de Búsqueda</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">ID Paciente</label>
                        <input type="number" class="form-control" @bind="_busquedaId" placeholder="Ej: 123" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nombres</label>
                        <input type="text" class="form-control" @bind="_busquedaNombre" placeholder="Ej: Juan" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Apellidos</label>
                        <input type="text" class="form-control" @bind="_busquedaApellido" placeholder="Ej: Pérez" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="BuscarPacientes" disabled="@_buscando">
                            @if (_buscando)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Buscando...</span>
                            }
                            else
                            {
                                <i class="bi bi-search me-2"></i>
                                <span>Buscar</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* SECCIÓN: MENSAJES Y ESTADOS *@
        @if (_mensajeError != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @_mensajeError
                <button type="button" class="btn-close" @onclick="() => _mensajeError = null"></button>
            </div>
        }

        @if (_busquedaRealizada && _pacientes != null)
        {
            @if (!_pacientes.Any())
            {
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-info-circle-fill"></i> No se encontraron pacientes con los criterios especificados.
                </div>
            }
            else
            {
                @* SECCIÓN: RESULTADOS DE BÚSQUEDA *@
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-people-fill"></i> Resultados: @_pacientes.Count paciente(s) encontrado(s)</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre Completo</th>
                                        <th>Fecha de Nacimiento</th>
                                        <th>Género</th>
                                        <th>Teléfono</th>
                                        <th>Dirección</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var paciente in _pacientes)
                                    {
                                        <tr>
                                            <td><strong>@paciente.PatientId</strong></td>
                                            <td>@paciente.FirstName @paciente.LastName</td>
                                            <td>@paciente.Dob?.ToString("dd/MM/yyyy")</td>
                                            <td>@paciente.Gender</td>
                                            <td>@(paciente.Phone ?? "N/A")</td>
                                            <td>@(paciente.Address ?? "N/A")</td>
                                            <td>
                                                <button class="btn btn-sm btn-primary me-1"
                                                        @onclick="() => VerHistorial(paciente.PatientId)">
                                                    <i class="bi bi-file-medical"></i> Historial
                                                </button>
                                                <button class="btn btn-sm btn-info"
                                                        @onclick="() => VerDetalles(paciente.PatientId)">
                                                    <i class="bi bi-eye"></i> Ver
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }

        @if (!_busquedaRealizada && !_buscando)
        {
            <div class="text-center text-muted mt-5">
                <i class="bi bi-search" style="font-size: 4rem;"></i>
                <p class="mt-3">Ingresa los criterios de búsqueda y presiona "Buscar"</p>
            </div>
        }

    </div>

</Autorizacion>

@code {
    // Criterios de búsqueda
    private int? _busquedaId;
    private string? _busquedaNombre;
    private string? _busquedaApellido;

    // Resultados y estados
    private List<Patient>? _pacientes;
    private bool _buscando = false;
    private bool _busquedaRealizada = false;
    private string? _mensajeError;

    private async Task BuscarPacientes()
    {
        try
        {
            _buscando = true;
            _mensajeError = null;
            _busquedaRealizada = false;

            // Validar que al menos un criterio esté presente
            if (!_busquedaId.HasValue && string.IsNullOrWhiteSpace(_busquedaNombre) && string.IsNullOrWhiteSpace(_busquedaApellido))
            {
                _mensajeError = "Debes ingresar al menos un criterio de búsqueda.";
                return;
            }

            // Llamada real al servicio para buscar pacientes
            _pacientes = await DoctorService.BuscarPacientesAsync(_busquedaId, _busquedaNombre, _busquedaApellido);

            _busquedaRealizada = true;
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al buscar pacientes: {ex.Message}";
        }
        finally
        {
            _buscando = false;
        }
    }

    private void VerHistorial(int pacienteId)
    {
        // Navega a la página de historial con el ID del paciente
        NavigationManager.NavigateTo($"/doctor/historial-paciente?pacienteId={pacienteId}");
    }

    private void VerDetalles(int pacienteId)
    {
        // TODO: Implementar modal o navegación a detalles completos
        Console.WriteLine($"Ver detalles del paciente: {pacienteId}");
    }
}
