@page "/doctor/prescripciones-activas"
@using HospitalData.Models
@using HospitalData.Services
@inject UserSessionService SessionService
@inject IDoctorService DoctorService

<PageTitle>Prescripciones Activas</PageTitle>

<Autorizacion RolRequerido="Doctor">
    
    <div class="container-fluid">
        <h1>💊 Prescripciones Activas</h1>
        <p>Consulta las prescripciones activas de tus pacientes</p>
        
        <hr />

        @* SECCIÓN: FILTROS DE BÚSQUEDA *@
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">ID Paciente</label>
                        <input type="number" class="form-control" @bind="_filtroPacienteId" placeholder="Buscar por ID" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Medicamento</label>
                        <input type="text" class="form-control" @bind="_filtroMedicamento" placeholder="Nombre del medicamento" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="AplicarFiltros" disabled="@_cargando">
                            <i class="bi bi-search me-2"></i>
                            Buscar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (_cargando)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2">Cargando prescripciones activas...</p>
            </div>
        }
        else if (_mensajeError != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @_mensajeError
                <button type="button" class="btn-close" @onclick="() => _mensajeError = null"></button>
            </div>
        }
        else if (_prescripciones == null || !_prescripciones.Any())
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill"></i> No hay prescripciones activas en este momento.
            </div>
        }
        else
        {
            @* SECCIÓN: ESTADÍSTICAS RÁPIDAS *@
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-bg-info">
                        <div class="card-body">
                            <h5 class="card-title">Total Prescripciones</h5>
                            <h2 class="card-text">@_prescripciones.Count</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-bg-success">
                        <div class="card-body">
                            <h5 class="card-title">Pacientes Únicos</h5>
                            <h2 class="card-text">@_prescripciones.Select(p => p.PatientId).Distinct().Count()</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-bg-warning">
                        <div class="card-body">
                            <h5 class="card-title">Medicamentos Distintos</h5>
                            <h2 class="card-text">@_prescripciones.Select(p => p.MedicationName).Distinct().Count()</h2>
                        </div>
                    </div>
                </div>
            </div>

            @* SECCIÓN: TABLA DE PRESCRIPCIONES *@
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-clipboard2-heart"></i> Prescripciones Activas</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>ID Prescripción</th>
                                    <th>ID Paciente</th>
                                    <th>Medicamento</th>
                                    <th>Dosificación</th>
                                    <th>Cantidad</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Duración</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prescripcion in _prescripcionesFiltradas.OrderByDescending(p => p.StartDate))
                                {
                                    <tr class="@(EstaProximaVencer(prescripcion) ? "table-warning" : "")">
                                        <td><strong>@prescripcion.PrescriptionId</strong></td>
                                        <td>@prescripcion.PatientId</td>
                                        <td>
                                            <strong>@prescripcion.MedicationName</strong>
                                            @if (EstaProximaVencer(prescripcion))
                                            {
                                                <span class="badge bg-warning text-dark ms-2">
                                                    <i class="bi bi-exclamation-triangle"></i> Próxima a vencer
                                                </span>
                                            }
                                        </td>
                                        <td>@(prescripcion.Dosage ?? "N/A")</td>
                                        <td>@prescripcion.QuantityToDispense</td>
                                        <td>@prescripcion.StartDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@prescripcion.EndDate?.ToString("dd/MM/yyyy")</td>
                                        <td>@CalcularDuracion(prescripcion)</td>
                                        <td>
                                            <button class="btn btn-sm btn-info" @onclick="() => VerDetallesPrescripcion(prescripcion.PrescriptionId)">
                                                <i class="bi bi-eye"></i> Ver
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @* PAGINACIÓN (Opcional para el futuro) *@
                    <div class="mt-3">
                        <p class="text-muted">
                            Mostrando @_prescripcionesFiltradas.Count() de @_prescripciones.Count prescripciones
                        </p>
                    </div>
                </div>
            </div>
        }
        
    </div>

</Autorizacion>

@code {
    // Lista completa de prescripciones
    private List<VwPatientActivePrescription>? _prescripciones;
    
    // Filtros
    private int? _filtroPacienteId;
    private string? _filtroMedicamento;

    // Estados
    private bool _cargando = true;
    private string? _mensajeError;

    // Prescripciones filtradas según criterios
    private IEnumerable<VwPatientActivePrescription> _prescripcionesFiltradas => 
        _prescripciones?.Where(p =>
        {
            if (_filtroPacienteId.HasValue && p.PatientId != _filtroPacienteId.Value)
                return false;
            
            if (!string.IsNullOrWhiteSpace(_filtroMedicamento) && 
                !p.MedicationName.Contains(_filtroMedicamento, StringComparison.OrdinalIgnoreCase))
                return false;

            return true;
        }) ?? Enumerable.Empty<VwPatientActivePrescription>();

    protected override async Task OnInitializedAsync()
    {
        await CargarPrescripciones();
    }

    private async Task CargarPrescripciones()
    {
        try
        {
            _cargando = true;
            _mensajeError = null;

            // Obtener el ID del doctor autenticado
            var doctorId = SessionService.CurrentUser?.UserId;
            
            if (doctorId == null)
            {
                _mensajeError = "No se pudo identificar al doctor autenticado.";
                return;
            }

            // Llamada real al servicio para obtener prescripciones activas
            _prescripciones = await DoctorService.ObtenerPrescripcionesActivasAsync(doctorId.Value);
        }
        catch (Exception ex)
        {
            _mensajeError = $"Error al cargar prescripciones: {ex.Message}";
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AplicarFiltros()
    {
        // Los filtros se aplican automáticamente a través de la propiedad _prescripcionesFiltradas
        // Este método puede usarse para realizar búsquedas más complejas en el servidor
        await Task.CompletedTask;
        StateHasChanged(); // Forzar actualización de la UI
    }

    private bool EstaProximaVencer(VwPatientActivePrescription prescripcion)
    {
        if (!prescripcion.EndDate.HasValue)
            return false;

        var fechaFin = prescripcion.EndDate.Value.ToDateTime(TimeOnly.MinValue);
        var diasRestantes = (fechaFin - DateTime.Now).TotalDays;

        return diasRestantes <= 7 && diasRestantes >= 0;
    }

    private string CalcularDuracion(VwPatientActivePrescription prescripcion)
    {
        if (!prescripcion.StartDate.HasValue || !prescripcion.EndDate.HasValue)
            return "N/A";

        var inicio = prescripcion.StartDate.Value.ToDateTime(TimeOnly.MinValue);
        var fin = prescripcion.EndDate.Value.ToDateTime(TimeOnly.MinValue);
        var duracion = (fin - inicio).TotalDays;

        if (duracion < 1)
            return "< 1 día";
        else if (duracion == 1)
            return "1 día";
        else if (duracion < 30)
            return $"{(int)duracion} días";
        else if (duracion < 365)
        {
            var meses = (int)(duracion / 30);
            return $"{meses} mes{(meses > 1 ? "es" : "")}";
        }
        else
        {
            var años = (int)(duracion / 365);
            return $"{años} año{(años > 1 ? "s" : "")}";
        }
    }

    private void VerDetallesPrescripcion(int prescripcionId)
    {
        // TODO: Implementar modal o navegación a detalles de prescripción
        Console.WriteLine($"Ver detalles de prescripción: {prescripcionId}");
    }
}
